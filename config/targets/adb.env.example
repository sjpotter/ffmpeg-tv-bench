# Example target: an Android device reached over adb. Copy to
# config/targets/<name>.env (git-ignored) and use it with: tv_bench.sh --target <name>
TYPE=adb
# Binary architecture (picks bin/ffmpeg-<variant>-<ARCH>); armeabi-v7a | arm64-v8a.
# Detected from the device; used as the assumption in --dry-run.
ARCH=armeabi-v7a
# Script that builds this architecture: build/<script> <worktree-dir> <variant>
BUILD=build/android-armeabi-v7a.sh
NOTES="example device"
# adb serial or HOST:PORT (192.0.2.0/24 is a documentation range)
SERIAL=192.0.2.10:5555
# Where clips, binaries and jobs live on the device (default /data/local/tmp/vc1bench)
#DEV_DIR=/data/local/tmp/vc1bench
# 1 = never wake the device, never touch its power settings (implies --no-wake).
# Set this for a device that must not be woken.
NO_WAKE=0
#NO_SMOKE=0
#COOLDOWN=10
#TIMEOUT=1800
#RECONNECT_TRIES=6
#VARIANTS="base threaded"
