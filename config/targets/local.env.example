# Example target: run the binaries on this Mac. Copy to config/targets/<name>.env
# (git-ignored) and use it with: tv_bench.sh --target <name>
TYPE=local
ARCH=macos
BUILD=build/macos.sh
NOTES="this Mac"
# Directory for the job scripts, logs and binary copies (default android/local-device)
#WORK_DIR=/path/to/scratch
# Directory holding ffmpeg-<variant>-macos (default android/bin; VC1_BIN also works)
#BIN_DIR=/path/to/bin
# Clips are read in place from $CORPUS/clips; nothing is copied or deleted.
