# Copy to config/local.env (git-ignored); sourced by android/tv_bench.sh and
# android/build_android.sh. Everything here is optional.
#BASE_VARIANT=base                  # single-threaded reference variant
#THREADED_VARIANT=threaded          # build under test (headline table)
#DEFAULT_VARIANTS="base threaded"   # default for --variants and build_android.sh
#SINGLE_VARIANTS="base single"      # variants that only run at 1 thread
#COMPARE_PAIRS="single:base"        # "new:base" pairs compared in the summary
#DEFAULT_CLIPS=...                  # alternative to config/clips.default
#SMOKE_CLIP=...
